{
  "name": "webcam-qr-scanner-pwa",
  "version": "0.2.0-beta.4",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/runtime-boundary.mjs",
    "build": "next build",
    "postbuild": "node scripts/runtime-boundary.mjs --next-traces",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "security:boundary": "node scripts/runtime-boundary.mjs --next-traces",
    "db:generate": "drizzle-kit generate",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs tests/*.test.mts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.4.0",
    "qr-scanner": "1.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "1.0.1",
    "vite": "8.3.4",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "fflate": "0.8.3",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "type": "module"
}
