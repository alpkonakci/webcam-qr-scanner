# Public values returned to the Windows client so it can authenticate to
# Supabase Realtime. The publishable key is intentionally safe to expose.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only. Configure this in Vercel; never prefix it with NEXT_PUBLIC_ and
# never commit a real value.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Server-only random value used when hashing anonymous rate-limit keys.
RELAY_RATE_LIMIT_PEPPER=replace-with-at-least-32-random-characters
